default_device_id: demo-device-001

defaults:
  stt:
    type: local
    model_dir: models/SenseVoiceSmall
    output_dir: outputs
  tts:
    type: local
    voice: zh-CN-XiaoxiaoNeural
    output_dir: outputs

devices:
  demo-device-001:
    llm:
      provider: ${DEMO_LLM_PROVIDER}
      model: ${DEMO_LLM_MODEL}
      base_url: ${DEMO_LLM_BASE_URL}
      api_key: ${DEMO_LLM_API_KEY}
