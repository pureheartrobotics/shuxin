<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:keepScreenOn="true">

    <TextureView
        android:id="@+id/cameraPreview"
        android:layout_width="320px"
        android:layout_height="240px"
        android:layout_gravity="bottom|start"
        android:alpha="0.02" />

    <cn.shuxin.car.face.WaveformView
        android:id="@+id/waveform"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/faceCluster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <cn.shuxin.car.face.CharacterFaceView
            android:id="@+id/faceCharacter"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/wakeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#DCEEFF"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="32dp"
            android:paddingVertical="16dp"
            android:text="轻触唤醒"
            android:textColor="#1A5F8A"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/resultCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:visibility="gone">

                <ImageView
            android:id="@+id/resultImage"
            android:layout_width="320dp"
            android:layout_height="180dp"
            android:layout_marginBottom="8dp"
            android:background="#F0F4F7"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/resultKicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:textColor="#66C8E8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#1A2A38"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#4A6070"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sleepHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="#EEF3F6"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="轻触休眠"
        android:textColor="#5A6B78"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="36dp"
        android:layout_marginBottom="28dp"
        android:alpha="0"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="#2C4A5E"
        android:textSize="18sp" />

    <ImageView
        android:id="@+id/bootLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:contentDescription="@null"
        android:padding="48dp"
        android:scaleType="fitCenter"
        android:src="@drawable/boot_logo" />

    <ScrollView
        android:id="@+id/labRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="未连接"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/boundText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="绑定：-"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="你说"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/sttText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="初心"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/replyText"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="—"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/motorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="电机：模拟 / 停"
                    android:textColor="@color/stop"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/logText"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp"
                    android:ellipsize="start"
                    android:fontFamily="monospace"
                    android:maxLines="4"
                    android:text=""
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/wsUrl"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@color/panel"
                    android:hint="ws://127.0.0.1:8765/ws/voice"
                    android:inputType="textUri"
                    android:padding="8dp"
                    android:text="ws://127.0.0.1:8765/ws/voice"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="机器人代号（robot_code，如 SX-000003）"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/deviceCode"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/panel"
                    android:hint="SX-000003"
                    android:inputType="textVisiblePassword"
                    android:padding="8dp"
                    android:text="SX-000003"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="用户名（user_name，不用设备密钥）"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/deviceSecret"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/panel"
                    android:hint="小林"
                    android:inputType="textPersonName"
                    android:padding="8dp"
                    android:text="小林"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/connectBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="连接云端" />

                <Button
                    android:id="@+id/talkBtn"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/talk"
                    android:enabled="false"
                    android:text="按住说话"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/stopBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/stop"
                    android:text="急停"
                    android:textColor="#1A1200"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/closeLabBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="回到黑屏" />

                <Button
                    android:id="@+id/powerOffBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="关机" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
