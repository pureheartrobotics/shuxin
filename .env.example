SHUXIN_HOME=/app/data/shuxin_home
VOICE_DEVICE_CONFIG=/app/data/devices.yaml
VOICE_DEMO_PORT=8765

# --- 阶段 A：宿主机大磁盘 bind mount（容器内路径仍为 /app/data 等）---
# 默认不设置则使用项目目录 ./data ./outputs ./models ./samples
# SHUXIN_HOST_DATA_DIR=/mnt/shuxin/data
# SHUXIN_HOST_OUTPUTS_DIR=/mnt/shuxin/outputs
# SHUXIN_HOST_MODELS_DIR=/mnt/shuxin/models
# SHUXIN_HOST_SAMPLES_DIR=/mnt/shuxin/samples
# 生产叠加 compose（无 src 热挂载）: COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- 本地开发：宿主机 Qdrant Dashboard 端口（避开本机已占用的 6333）---
QDRANT_HTTP_PORT=6335
SHUXIN_MEM0_ENABLED=1

# --- 生产服务器（上线前改回）：QDRANT_HTTP_PORT=6333 或按运维取消公网映射 ---
# QDRANT_HTTP_PORT=6333

# Demo LLM configuration. Copy this file to .env and fill real values.
DEMO_LLM_PROVIDER=openai-compatible
DEMO_LLM_MODEL=deepseek-chat
DEMO_LLM_BASE_URL=
DEMO_LLM_API_KEY=

# TTS: Volcengine voice clone (see data/tts_profiles.yaml for multi-agent profiles)
# After editing, run: bash scripts/redeploy_docker.sh  (compose must pass vars into container)
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_API_URL=https://openspeech.bytedance.com/api/v1/tts
VOLCENGINE_TTS_VOICE_TYPE=
# Optional TTS profile registry path (default data/tts_profiles.yaml)
# VOICE_TTS_PROFILES_CONFIG=/app/data/tts_profiles.yaml
SHUXIN_TTS_TIMEOUT_SECONDS=30
SHUXIN_TTS_CONNECT_TIMEOUT_SECONDS=5

# Legacy Edge+karen FX (test scripts only; production uses volcengine-clone)
# SHUXIN_TTS_EFFECT=karen

# Device secret encryption (Fernet). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHUXIN_DEVICE_SECRET_ENCRYPTION_KEY=
