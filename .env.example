SHUXIN_HOME=/app/data/shuxin_home
VOICE_DEVICE_CONFIG=/app/data/devices.yaml
VOICE_DEMO_PORT=8765

# --- 阶段 A：宿主机大磁盘 bind mount（容器内路径仍为 /app/data 等）---
# 默认不设置则使用项目目录 ./data ./outputs ./models ./samples
# SHUXIN_HOST_DATA_DIR=/mnt/shuxin/data
# SHUXIN_HOST_OUTPUTS_DIR=/mnt/shuxin/outputs
# SHUXIN_HOST_MODELS_DIR=/mnt/shuxin/models
# SHUXIN_HOST_SAMPLES_DIR=/mnt/shuxin/samples
# 生产叠加 compose（无 src 热挂载）: COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- 本地开发：宿主机 Qdrant Dashboard 端口（避开本机已占用的 6333）---
QDRANT_HTTP_PORT=6335
SHUXIN_MEM0_ENABLED=1

# 工厂验收扫码日志保留天数（0 = 不删）；小程序与 Admin 查询均受此限制
SHUXIN_FACTORY_VERIFY_LOG_RETENTION_DAYS=15

# --- 生产服务器（上线前改回）：QDRANT_HTTP_PORT=6333 或按运维取消公网映射 ---
# QDRANT_HTTP_PORT=6333

# Demo LLM configuration. Copy this file to .env and fill real values.
DEMO_LLM_PROVIDER=openai-compatible
DEMO_LLM_MODEL=deepseek-chat
DEMO_LLM_BASE_URL=
DEMO_LLM_API_KEY=

# DMXAPI per-user token provisioning (WeChat first login -> 10 CNY quota)
DMX_SYSTEM_TOKEN=
DMX_API_USER_ID=
DMX_API_BASE_URL=https://www.dmxapi.cn
SHUXIN_LLM_DEFAULT_PROVIDER=openai-compatible
SHUXIN_LLM_DEFAULT_MODEL=deepseek-chat
# 测试模式：Admin 删除用户为真删（解绑+清记忆）；生产保持 0
SHUXIN_VOICE_TEST_MODE=0

# Hardware WebSocket downlink chunking (Opus/MP3 binary frames; web-demo sends whole MP3)
# SHUXIN_WS_DOWNLINK_MAX_BYTES=2048
# SHUXIN_WS_DOWNLINK_YIELD_MS=0

# TTS: Volcengine voice clone (see data/tts_profiles.yaml for multi-agent profiles)
# After editing, run: bash scripts/redeploy_docker.sh  (compose must pass vars into container)
VOLCENGINE_TTS_API_KEY=

# Baidu Map MCP (platform-managed AK; map tools disabled when unset)
SHUXIN_BAIDU_MAP_AK=
# After editing map vars, ensure docker-compose.yml passes them and redeploy:
#   bash scripts/redeploy_docker.sh --skip-build
# SHUXIN_MAP_TOOLS_ENABLED=1
# SHUXIN_MAP_MCP_URL=https://mcp.map.baidu.com/mcp
# SHUXIN_MAP_MCP_TIMEOUT_SECONDS=3
# SHUXIN_MAP_MAX_TOOL_ROUNDS=1
# SHUXIN_MAP_GATE_ENABLED=1
# SHUXIN_MAP_DEFAULT_REGION=北京
# SHUXIN_LOCATION_CACHE_TTL_SECONDS=1800
VOLCENGINE_TTS_API_URL=https://openspeech.bytedance.com/api/v1/tts
VOLCENGINE_TTS_VOICE_TYPE=
# Optional TTS profile registry path (default data/tts_profiles.yaml)
# VOICE_TTS_PROFILES_CONFIG=/app/data/tts_profiles.yaml
SHUXIN_TTS_TIMEOUT_SECONDS=30
SHUXIN_TTS_CONNECT_TIMEOUT_SECONDS=5

# Legacy Edge+karen FX (test scripts only; production uses volcengine-clone)
# SHUXIN_TTS_EFFECT=karen

# WeChat Pay (mini program subscription recharge)
# Place merchant private key at data/certs/apiclient_key.pem (from WeChat cert ZIP)
# Copy data/payment_plans.example.json -> data/payment_plans.json to customize plans.
# SHUXIN_WXPAY_MCHID=
# SHUXIN_WXPAY_API_V3_KEY=
# SHUXIN_WXPAY_CERT_SERIAL_NO=
# SHUXIN_WXPAY_PRIVATE_KEY_PATH=/app/data/certs/apiclient_key.pem
# SHUXIN_WXPAY_PLATFORM_CERT_DIR=/app/data/certs/wxpay_platform
# New merchants use WeChat Pay public key (not platform cert). Download from
# pay.weixin.qq.com -> 账户中心 -> API安全 -> 微信支付公钥
# SHUXIN_WXPAY_PUBLIC_KEY_PATH=/app/data/certs/wxp_pub.pem
# SHUXIN_WXPAY_PUBLIC_KEY_ID=PUB_KEY_ID_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SHUXIN_WXPAY_NOTIFY_URL=https://your-domain.example/api/payment/notify
# SHUXIN_PAYMENT_PLANS_FILE=/app/data/payment_plans.json
# SHUXIN_PAYMENT_PLANS=[{"id":"monthly","name":"月卡","amount_fen":2990,"add_yuan":29.9,"duration_days":30}]

# Device secret encryption (Fernet). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHUXIN_DEVICE_SECRET_ENCRYPTION_KEY=
